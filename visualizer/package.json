{
  "name": "skepu-visualizer",
  "displayName": "SkeVU",
  "description": "SkePU visualizer for web and as a VSCode extension",
  "version": "1.0.0",
  "publisher": "skepu",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "skepu.skevu",
        "displayName": "SkeVU Visualizer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "skepu_trace*.json"
          },
          {
            "filenamePattern": "trace_*.json"
          },
          {
            "filenamePattern": "*.skevu"
          }
        ]
      },
      {
        "viewType": "skepu.skevu.any",
        "displayName": "SkeVU Visualizer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "vscode:prepublish": "npm run build && npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies --skip-license",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skepu/skepu.git",
    "directory": "visualizer"
  }
}
