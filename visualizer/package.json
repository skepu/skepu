{
  "name": "skepu-visualizer",
  "displayName": "SkeVU",
  "description": "SkePU visualizer for web and as a VSCode extension",
  "version": "1.0.0",
  "publisher": "skepu",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "skepu.skevu",
        "displayName": "SkeVU Visualizer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.skevu"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "skevu.openGuide",
        "title": "SkeVU: Open the User Guide"
      },
      {
        "command": "skevu.openGuideInWindow",
        "title": "SkeVU: Open the User Guide in a New Window"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "vscode:prepublish": "npm run build && npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -w -p ./",
    "license": "node -e \"require('fs').copyFileSync('../LICENSE.txt', 'LICENSE.txt')\"",
    "package": "npm run license && vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skepu/skepu.git",
    "directory": "visualizer"
  },
  "activationEvents": [
    "onUri",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp"
  ]
}
