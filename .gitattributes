# Generated data and vendored code: kept out of the diffs (git diff says "Binary files differ", for the generated data that is hard to read;
# GitHub collapses these files and leaves them out of the language statistics). `git diff --text` shows such a diff when it is wanted.

# SkeVU: the traces of the examples and their snapshots (made again by running the examples), and the digests of the golden tests
visualizer/examples/**/trace_*.json   -diff linguist-generated
visualizer/examples/**/*.zip          linguist-generated
visualizer/tests/golden/**            linguist-generated
visualizer/package-lock.json          -diff linguist-generated

# Vendored libraries
visualizer/static/**                  linguist-vendored
visualizer/static/**/*.min.js         -diff
visualizer/static/cytoscape.js-elk-2.3.0/dist/elk.bundled.js  -diff
external/**                           linguist-vendored
examples/lodepng.*                    linguist-vendored
