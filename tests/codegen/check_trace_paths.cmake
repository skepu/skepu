# Checks the names of the files in a trace (cmake -DTRACE=file [-DFILES=a.cpp;b.cpp] -P check_trace_paths.cmake): none is absolute or has "." or ".." in it, and the
# files in FILES (a list of the names that the trace must have in header.files) are there.
cmake_minimum_required(VERSION 3.18) # script mode has no policies of its own: IN_LIST below needs CMP0057
if(NOT EXISTS ${TRACE})
	message(FATAL_ERROR "no trace file ${TRACE}")
endif()
file(READ ${TRACE} _trace)
function(check_name name where)
	if(name MATCHES "^/" OR name MATCHES "^[A-Za-z]:[/\\\\]" OR name MATCHES "(^|/)\\.\\.?(/|$)" OR name MATCHES "//")
		message(FATAL_ERROR "${where}: the file name '${name}' is absolute or has dots or doubled slashes in it")
	endif()
endfunction()

string(JSON _data GET "${_trace}" data)
string(JSON _length LENGTH "${_data}")
math(EXPR _last "${_length} - 1")
foreach(_i RANGE ${_last})
	string(JSON _name ERROR_VARIABLE _none GET "${_data}" ${_i} file)
	if(_name AND NOT _name STREQUAL "NOTFOUND" AND NOT _none)
		check_name("${_name}" "event ${_i}")
	endif()
endforeach()

string(JSON _files ERROR_VARIABLE _none GET "${_trace}" header files)
set(_names "")
if(NOT _none)
	string(JSON _count LENGTH "${_files}")
	if(_count GREATER 0)
		math(EXPR _lastFile "${_count} - 1")
		foreach(_i RANGE ${_lastFile})
			string(JSON _name MEMBER "${_files}" ${_i})
			check_name("${_name}" "header.files")
			list(APPEND _names "${_name}")
		endforeach()
	endif()
endif()
foreach(_expected ${FILES})
	if(NOT _expected IN_LIST _names)
		message(FATAL_ERROR "header.files has no ${_expected} (it has: ${_names})")
	endif()
endforeach()
