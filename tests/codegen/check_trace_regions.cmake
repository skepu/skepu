# Checks a trace made by tracing_regions_threads.cpp (cmake -DTRACE=file -DREGIONS=n -DEVENTS=m -P): every
# allocation event's region is the one in its label ("R<t> event"), and there are n regions of depth 1.
if(NOT EXISTS ${TRACE})
	message(FATAL_ERROR "no trace file ${TRACE}")
endif()
file(READ ${TRACE} _trace)
string(JSON _length LENGTH "${_trace}")
set(_allocations 0)
set(_regions 0)
math(EXPR _last "${_length} - 1")
foreach(_i RANGE ${_last})
	string(JSON _type GET "${_trace}" ${_i} type)
	if(_type STREQUAL "region")
		string(JSON _depth GET "${_trace}" ${_i} region_depth)
		if(NOT _depth EQUAL 1)
			message(FATAL_ERROR "region event ${_i} has depth ${_depth}, expected 1 (regions of other threads must not nest)")
		endif()
		math(EXPR _regions "${_regions} + 1")
	elseif(_type STREQUAL "allocation")
		string(JSON _label GET "${_trace}" ${_i} label)
		string(JSON _region ERROR_VARIABLE _none GET "${_trace}" ${_i} region)
		string(REGEX MATCH "^R[0-9]+" _expected "${_label}")
		if(NOT _region STREQUAL _expected)
			message(FATAL_ERROR "allocation event '${_label}' is in region '${_region}', expected '${_expected}'")
		endif()
		math(EXPR _allocations "${_allocations} + 1")
	endif()
endforeach()
if(NOT _regions EQUAL ${REGIONS} OR NOT _allocations EQUAL ${EVENTS})
	message(FATAL_ERROR "${TRACE}: ${_regions} regions (expected ${REGIONS}) and ${_allocations} allocations (expected ${EVENTS})")
endif()
