+    SkeletonDescriptions[par.first] = par.second;
+  }
+
+  SkeletonTypes.clear();
+  for(auto skeleType : AST.getSkeletonTypes())
+  {
+    SkeletonTypes.push_back(skeleType);
+  }
+}
