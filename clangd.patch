+std::string generateParameterString(ScoredSignature& SS, const std::string& skeletonName, const std::vector<std::string>& parameters, const std::string& retType)
+{
+	std::string label{"skepu::" + skeletonName + "("};
+	for (auto iter = parameters.begin(); iter != parameters.end(); ++iter) {
+		const std::string& elem = *iter;
+		label += elem;
+		ParameterInformation pi{};
+		pi.labelString = elem;
+		
+		SS.Signature.parameters.push_back(pi);
+		if (iter != parameters.end() - 1)
+		label += ", ";
+	}
+
+	label += ")";
+	if(retType != "")
+		label += " -> " + retType;
+	return label;
+}
