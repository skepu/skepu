+bool isSkepuSkeleton(ParsedAST &AST, const clang::NamedDecl* Decl, clang::SourceLocation const& CurLoc)
+{
+  std::vector<std::string> vec = AST.getSkeletonTypes();
+  for (auto &e : vec)
+  {
+    if (e.find(Decl->getNameAsString()) != std::string::npos)
+    {
+      if (const FunctionDecl *FD = getUnderlyingFunction(Decl))
+      {
+        if (const auto *NS = FD->getEnclosingNamespaceContext()) {
+          if (auto *NSD = dyn_cast_or_null<NamespaceDecl>(NS)){
+            return NSD->getQualifiedNameAsString() == "skepu";
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
+
+Skeleton* getSkepuDecl(ParsedAST &AST, const clang::NamedDecl* Decl, clang::SourceLocation const& CurLoc){
+  std::string DeclName{Decl->getNameAsString()};
+  clang::SourceLocation Loc{Decl->getLocation()};
+
+  const SourceManager& sm = AST.getASTContext().getSourceManager();
+  for (auto skeleton : AST.getSkeletonFunctions())
+  {
+    if (skeleton == nullptr)
+      continue;
+    if (skeleton->variableName != DeclName )
+      continue;
+
+    FullSourceLoc declLoc(CurLoc, sm);
+    FullSourceLoc skelLoc(CurLoc, sm);
+    if (skelLoc.getSpellingLineNumber() == declLoc.getSpellingLineNumber())
+      return skeleton;
+  }
+  
+  return nullptr;
+}
