+struct SkepuParam
+{
+	enum ParamType
+	{
+		ElWise,
+		RandomAccess,
+		Scalar,
+		VElWise,
+		HElWise,
+	};
+
+	ParamType type;
+	std::string param;
+
+	std::string toString() const
+	{
+		std::string ret = "param: " + param + ", type: ";
+		switch (type) {
+			case ParamType::ElWise:
+				ret += "ElWise";
+				break;
+			case ParamType::RandomAccess:
+				ret += "RandomAccess";
+				break;
+			case ParamType::Scalar:
+				ret += "Scalar";
+				break;
+			case ParamType::VElWise:
+				ret += "VElWise";
+				break;
+			case ParamType::HElWise:
+				ret += "HElWise";
+				break;
+		}
+		return ret;
+	}
+};
